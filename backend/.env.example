# ClassBoard Backend Environment Variables

# MongoDB connection string (get this from MongoDB Atlas → Connect → Drivers)
# Example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Google OAuth Client ID (from Google Cloud Console → APIs & Services → Credentials)
# Same value must go into REACT_APP_GOOGLE_CLIENT_ID in the frontend (Vercel env vars)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# JWT secret — change to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Admin emails — comma-separated, these users get admin role and see ALL sessions
ADMIN_EMAILS=itsvikash143@gmail.com

# Legacy teacher email (kept for backwards compatibility)
TEACHER_EMAIL=itsvikash143@gmail.com

# Server port
PORT=3001
